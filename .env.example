# --- Vision scan server (server/index.js) — server-side only, never exposed to the browser ---
# Which vision backend analyzes each capture. "gemini" is primary; "eyepop" is kept as a
# pluggable alternative (see server/visionProviders/). Selects the provider in
# server/visionProviders/index.js — falls back to "gemini" if unset or unrecognized.
VISION_PROVIDER="gemini"

# Required unless MOCK_VISION=true. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional: pins EyePop to a Pop UUID already configured in the EyePop dashboard, only used
# when VISION_PROVIDER=eyepop. If unset, server/visionProviders/eyepopClient.js builds an
# inline eyepop.localize-objects:latest pop prompted with the class list in
# src/vision/fixtureClasses.js.
EYEPOP_POP_ID="your_pop_id_here"
# Required only when VISION_PROVIDER=eyepop (unless MOCK_VISION=true).
EYEPOP_API_KEY="your_api_key_here"

# Set to "true" to return canned per-step detections instead of calling a real vision API
# (no credentials/network needed). Always shows a visible "Demo data" badge in the UI.
MOCK_VISION="false"
# Which port server/index.js listens on; must match the target in vite.config.js's dev proxy.
SCAN_SERVER_PORT="8787"

# --- Frontend (Vite exposes only VITE_-prefixed vars to the browser) ---
# Forces the reference UI's scan engine onto the "demo" vision backend — fully offline,
# no server/network calls at all (see src/engine/demoBackend.js, docs/MOBILE_TESTING.md
# test #11). Leave unset to use the server's VISION_PROVIDER (gemini by default).
VITE_VISION_BACKEND=""